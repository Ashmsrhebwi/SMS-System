# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="FeRa Clinic SMS"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://sms.feraclinic.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────────────────────────────────
# Use "daily" in production so logs rotate automatically (14-day retention)
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_production_database_name
DB_USERNAME=your_production_db_user
DB_PASSWORD=your_production_db_password

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=sms.feraclinic.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# ─── Cache & Queue ────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# IMPORTANT: Must be > DispatchCampaignJob timeout (3600s) to prevent phantom retries
DB_QUEUE_RETRY_AFTER=3700

# ─── CORS & Sanctum ───────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://sms.feraclinic.com
SANCTUM_STATEFUL_DOMAINS=sms.feraclinic.com
SANCTUM_TOKEN_EXPIRATION=480

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=consultation@feraclinic.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=consultation@feraclinic.com
MAIL_FROM_NAME="FeRa Clinic"

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMS Settings ─────────────────────────────────────────────────────────────
SMS_RATE_LIMIT_DELAY=1
SMS_OPT_OUT_TEXT="To stop receiving messages, visit: {opt_out_url}"
SMS_WHATSAPP_URL=https://wa.me/

# ─── AWS (unused — leave blank unless using S3) ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite (build-time only, not needed on server) ────────────────────────────
VITE_APP_NAME="${APP_NAME}"
